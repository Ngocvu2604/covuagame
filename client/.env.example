# Cấu hình Appwrite cho Chess Arena (bản mẫu environment)
# Copy file này thành `client/.env` cho local dev.
# Với Vercel: thêm từng biến vào Project → Settings → Environment Variables.
# KHÔNG commit file .env thật lên GitHub (đã có trong .gitignore).

# 1) Endpoint của Appwrite Cloud (xem Console → Settings → API Endpoint)
#    Hình dạng: https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1

# 2) ID của Appwrite Project (Console → Settings → Project ID)
VITE_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# 3) ID của Database (Console → Databases → tạo database, ví dụ "chess-arena")
#    PHẢI trùng với APPWRITE_DATABASE_ID đã dùng khi chạy scripts/setup-appwrite.js
#    (nếu bạn tái sử dụng database có sẵn do gói Free hết quota database)
VITE_APPWRITE_DATABASE_ID=chess-arena
# 4) ID các collection (có thể giữ nguyên tên mặc định)
VITE_APPWRITE_ROOMS_COLLECTION_ID=rooms
VITE_APPWRITE_MOVES_COLLECTION_ID=moves
VITE_APPWRITE_MESSAGES_COLLECTION_ID=messages
